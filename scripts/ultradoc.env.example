# Settings for scripts/backup.sh, restore.sh and healthcheck.sh.
# Install on the VM as /opt/ultradoc/ultradoc.env with mode 600 (it holds keys):
#   sudo install -m 600 -o deploy -g deploy scripts/ultradoc.env.example /opt/ultradoc/ultradoc.env
#
# Backup credentials come from terraform/aws-local:
#   terraform output -raw backup_access_key_id
#   terraform output -raw backup_secret_access_key

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:4566
S3_BUCKET=ultradoc-backups

# Public URL nginx serves (self-signed cert; scripts use curl -k).
APP_URL=https://127.0.0.1

# Local backup copies to keep (newest first).
KEEP_LOCAL=7

# healthcheck.sh thresholds
DISK_MAX_PERCENT=85
MEM_MIN_MB=200
